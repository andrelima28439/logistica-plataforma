# Copie para `.env` antes do primeiro `docker compose up`:
#   copy .env.example .env   (Windows cmd)
# Valores abaixo são APENAS para desenvolvimento local. Nunca commitar `.env`.

# SQL Server (Express). Precisa atender à política de complexidade da Microsoft.
MSSQL_SA_PASSWORD=Logistica@2026!Dev

# RabbitMQ (usuário do painel http://localhost:15672)
RABBITMQ_DEFAULT_USER=logistica
RABBITMQ_DEFAULT_PASS=logistica-dev-2026

# Grafana (painel http://localhost:3000)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
